---
import type { SiteConfig } from "../../lib/publish-guard";

interface Props {
  site: SiteConfig;
  whatsappLink: string;
  waPath: string;
}

const { site, whatsappLink, waPath } = Astro.props;
---

<section id="inicio" class="scroll-mt-20 py-(--space-section)">
  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
    <p
      class="inline-flex items-center gap-2 rounded-(--radius-btn) border border-primary/25 bg-primary/5 px-4 py-1.5 text-sm font-medium text-primary-dark"
    >
      <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      Atención en {site.ubicacion.distrito}
    </p>

    <h1
      class="mx-auto mt-6 max-w-4xl text-4xl leading-tight font-semibold tracking-tight text-ink sm:text-5xl lg:text-6xl"
    >
      {site.hero.titular}
    </h1>

    <p
      class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink/85 sm:text-xl"
    >
      {site.hero.subtitulo}
    </p>

    <div
      class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row"
    >
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2.5 rounded-(--radius-btn) bg-primary px-8 py-4 text-base font-semibold text-surface transition-colors hover:bg-primary-dark sm:w-auto"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"
          ><path d={waPath}></path></svg
        >
        Agendar por WhatsApp
      </a>
      <a
        href={site.contacto.telefonoHref}
        class="inline-flex w-full items-center justify-center gap-2 rounded-(--radius-btn) border-2 border-primary-dark/25 px-8 py-3.5 text-base font-semibold text-primary-dark transition-colors hover:border-primary-dark sm:w-auto"
      >
        Llamar al {site.contacto.telefonoVisible}
      </a>
    </div>

    <dl
      class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-6 border-y border-ink/15 py-6 text-left sm:grid-cols-3 sm:text-center"
    >
      {
        site.hero.datosConfianza.map((dato) => (
          <div class="border-l-2 border-accent pl-3.5 sm:border-l-0 sm:pl-0">
            <dt class="text-xs font-medium tracking-wider text-ink/70 uppercase">
              {dato.etiqueta}
            </dt>
            <dd class="mt-1 text-base font-semibold text-ink">{dato.valor}</dd>
          </div>
        ))
      }
    </dl>

    <div
      class="relative mt-12 aspect-[16/9] w-full overflow-hidden rounded-(--radius-card) bg-primary/10 text-left"
    >
      {
        site.hero.imagen.src ? (
          <img
            src={site.hero.imagen.src}
            alt={site.hero.imagen.alt}
            width="1200"
            height="675"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        ) : (
          <div class="flex h-full items-end p-6">
            <p class="w-full rounded-(--radius-card) bg-surface/95 p-4 text-sm font-medium text-ink">
              {site.hero.imagen.placeholder}
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
