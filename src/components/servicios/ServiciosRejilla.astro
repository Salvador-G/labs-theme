---
import type { SiteConfig } from "../../lib/publish-guard";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<section
  id="servicios"
  class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {site.textosSecciones.serviciosTitulo}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-ink/80">
        {site.textosSecciones.serviciosSubtitulo}
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        site.servicios.map((servicio) => {
          const Card = servicio.href ? "a" : "div";
          return (
            <li>
              <Card
                href={servicio.href || undefined}
                class="group flex h-full flex-col justify-between rounded-(--radius-card) border border-ink/15 bg-surface p-6 transition-colors hover:border-primary/40 hover:bg-primary/5"
              >
                <div>
                  <h3 class="text-xl font-semibold text-ink group-hover:text-primary-dark">
                    {servicio.nombre}
                  </h3>
                  <p class="mt-2.5 text-sm leading-relaxed text-ink/80">
                    {servicio.descripcion}
                  </p>
                </div>
                {servicio.href && (
                  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
                    Ver detalles
                    <svg
                      class="h-4 w-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                      />
                    </svg>
                  </span>
                )}
              </Card>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
