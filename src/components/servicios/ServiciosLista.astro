---
import type { SiteConfig } from "../../lib/publish-guard";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<section
  id="servicios"
  class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
>
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16 lg:px-8"
  >
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {site.textosSecciones.serviciosTitulo}
        </h2>
        <p class="mt-3 max-w-sm text-base leading-relaxed text-ink/80">
          {site.textosSecciones.serviciosSubtitulo}
        </p>
      </div>
    </div>

    <ul class="divide-y divide-ink/15 border-y border-ink/15 lg:col-span-8">
      {
        site.servicios.map((servicio) => {
          const Fila = servicio.href ? "a" : "div";
          return (
            <li>
              <Fila
                href={servicio.href || undefined}
                class="group flex items-start justify-between gap-6 py-6 transition-colors hover:bg-primary/5 sm:px-3"
              >
                <div>
                  <h3 class="text-xl font-semibold text-ink group-hover:text-primary-dark">
                    {servicio.nombre}
                  </h3>
                  <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-ink/80">
                    {servicio.descripcion}
                  </p>
                </div>
                {servicio.href && (
                  <svg
                    class="mt-1 h-5 w-5 shrink-0 text-primary transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.75"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                    />
                  </svg>
                )}
              </Fila>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
