        <div class:list={["grid grid-cols-1 gap-12", site.mostrarFormulario && "lg:grid-cols-12"]}>
          <div class:list={[site.mostrarFormulario ? "lg:col-span-5" : "max-w-xl"]}>
            <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Coordina tu cita</h2>
            <p class="mt-3 text-base leading-relaxed text-ink/80">
