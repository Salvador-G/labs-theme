                    {caso.despues.src ? (
                      <img src={caso.despues.src} alt={caso.despues.alt} loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full items-end bg-primary/15 p-3">
                        <p class="rounded bg-surface/95 p-2.5 text-xs font-medium text-ink">{caso.despues.placeholder}</p>
                      </div>
                    )}
                    <span class="absolute top-3 right-3 rounded bg-primary-dark px-2.5 py-1 text-xs font-semibold text-surface">Después</span>
                  </div>

                  <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0);">
                    {caso.antes.src ? (
                      <img src={caso.antes.src} alt={caso.antes.alt} loading="lazy" class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full items-end bg-ink/15 p-3">
                        <p class="rounded bg-surface/95 p-2.5 text-xs font-medium text-ink">{caso.antes.placeholder}</p>
                      </div>
                    )}
