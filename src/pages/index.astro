              </a>
            </li>
          </ul>
        </div>

        {redes.length > 0 && (
          <div class="md:col-span-3">
            <h2 class="text-sm font-semibold text-ink/75">Redes sociales</h2>
            <ul class="mt-3 flex flex-wrap gap-3">
              {redes.map((red) => (
                <li>
                  <a href={red.href} target="_blank" rel="noopener noreferrer" class="inline-block rounded-full border border-ink/25 px-3.5 py-1.5 text-sm font-medium text-ink hover:border-primary hover:text-primary">
                    {red.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <p class="mt-10 border-t border-ink/10 pt-6 text-sm text-ink/75">{site.footer.derechos}</p>
    </div>
  </footer>

  <!-- Botón flotante de WhatsApp (solo celular) -->
  <a
    href={whatsappLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Agendar cita por WhatsApp"
    class="fixed right-4 bottom-4 z-40 inline-flex items-center gap-2 rounded-full bg-primary px-4 py-3 text-sm font-semibold text-surface shadow-lg lg:hidden"
  >
    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={waPath} /></svg>
    WhatsApp
  </a>

  <script>
    // Menú móvil: se cierra al elegir un enlace o con la tecla Escape
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    function setMenu(abierto: boolean) {
      if (!menuToggle || !mobileMenu || !iconOpen || !iconClose) return;
      menuToggle.setAttribute("aria-expanded", String(abierto));
      menuToggle.setAttribute("aria-label", abierto ? "Cerrar menú de navegación" : "Abrir menú de navegación");
      mobileMenu.classList.toggle("hidden", !abierto);
      iconOpen.classList.toggle("hidden", abierto);
      iconClose.classList.toggle("hidden", !abierto);
    }

    menuToggle?.addEventListener("click", () =>
      setMenu(menuToggle.getAttribute("aria-expanded") !== "true")
    );
    document.querySelectorAll(".mobile-nav-link").forEach((enlace) =>
      enlace.addEventListener("click", () => setMenu(false))
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setMenu(false);
    });

    // Comparador antes/después (controlado con <input type="range">)
    document.querySelectorAll<HTMLInputElement>(".before-after-slider").forEach((slider) => {
      const wrapper = slider.closest("article")?.querySelector<HTMLElement>(".before-after-wrapper");
      if (!wrapper) return;
      slider.addEventListener("input", () => {
        wrapper.style.setProperty("--pos", `${slider.value}%`);
      });
    });
  </script>
</Layout>