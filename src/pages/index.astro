---
import Layout from "../layouts/Layout.astro";

// ============================================================================
// CONFIGURACIÓN DEL SITIO
// Todo el contenido vive en el objeto `site`. El HTML solo lo lee.
//   · [Entre corchetes] = dato que el cliente debe confirmar. Si queda alguno
//     visible, `astro build` falla (salvo en modo demo, ver más abajo).
//   · Para cambiar de nicho: tipoConsultorio = "psicologo".
//   · Para publicar una demo con marcadores: PUBLIC_DEMO=true astro build
//     (además añade noindex para que Google no la indexe).
// ============================================================================
const nombre = "[Nombre del Consultorio]";
const distrito = "[Distrito]";
const tipoConsultorio = "dentista" as "dentista" | "psicologo";
const esPsicologo = tipoConsultorio === "psicologo";

type Imagen = { src: string; alt: string; placeholder: string };
// Para poner una foto real: { src: "/img/hero.webp", alt: "Descripción", placeholder: "" }
const foto = (placeholder: string): Imagen => ({ src: "", alt: "", placeholder });

const site = {
  nombre,
  tipo: tipoConsultorio,
  seo: {
    titulo: `${nombre} | Atención en ${distrito}`,
    descripcion: esPsicologo
      ? `Consultorio de psicología en ${distrito}. Espacio confidencial para terapia individual y acompañamiento emocional, con cita previa.`
      : `Consultorio odontológico en ${distrito}. Prevención, diagnóstico y tratamientos dentales con cita previa.`,
  },

  // Cada consultorio cambia solo estos valores. Contraste AA verificado con estos:
  // ink/surface 14,9:1 · primary/surface 7,7:1 · accent/surface 5,2:1
  colores: {
    primary: "#1E564F",
    primaryDark: "#133B36",
    accent: "#A94B30",
    surface: "#F7F5F0",
    ink: "#182220",
  },

  // Activa cada sección solo cuando haya contenido real y verificable.
  mostrarAntesDespues: !esPsicologo, // requiere consentimiento firmado de cada paciente
  mostrarTestimonios: !esPsicologo, // reseñas reales y con permiso
  mostrarFormulario: true, // Básico: false (solo WhatsApp y teléfono) · Profesional: true

  textosSecciones: {
    serviciosNav: esPsicologo ? "Servicios" : "Tratamientos",
    serviciosTitulo: esPsicologo
      ? "Áreas de acompañamiento psicológico"
      : "Qué podemos hacer por tu salud bucal",
    serviciosSubtitulo: esPsicologo
      ? "Un abordaje adaptado a tu etapa de vida y a lo que necesitas trabajar."
      : "Cada tratamiento empieza con una evaluación y una explicación clara de tus opciones.",
    primeraCitaNav: esPsicologo ? "Primera sesión" : "Primera cita",
    primeraCitaTitulo: esPsicologo
      ? "Cómo es la primera sesión"
      : "Qué esperar en tu primera consulta",
    primeraCitaSubtitulo:
      "Saber cómo es el proceso de antemano hace que la visita sea más tranquila.",
  },

  hero: {
    titular: esPsicologo
      ? `Un espacio profesional y confidencial para cuidar tu bienestar emocional en ${distrito}`
      : `Cuidado dental claro y preventivo en ${distrito}`,
    subtitulo: esPsicologo
      ? "Atención psicológica con objetivos definidos en conjunto, en un entorno tranquilo y respetuoso."
      : "Te explicamos cada alternativa de tratamiento antes de tomar cualquier decisión.",
    imagen: foto(
      esPsicologo
        ? "Foto: consultorio psicológico con luz natural"
        : "Foto: consultorio odontológico limpio y luminoso"
    ),
    datosConfianza: [
      {
        etiqueta: esPsicologo ? "Colegiatura C.Ps.P." : "Colegiatura COP",
        valor: "[N.º de colegiatura]",
      },
      { etiqueta: "Atención", valor: "Con cita previa" },
      { etiqueta: "Ubicación", valor: distrito },
    ],
  },

  // Si el profesional anuncia una especialidad (ej. ortodoncia), debe tener su registro de especialista.
  servicios: esPsicologo
    ? [
        { nombre: "Psicoterapia individual para adultos", descripcion: "Un espacio de diálogo clínico para momentos de transición, decisiones difíciles y manejo emocional.", href: "" },
        { nombre: "Acompañamiento a adolescentes", descripcion: "Orientación sobre identidad, habilidades sociales y vínculo familiar.", href: "" },
        { nombre: "Terapia de pareja", descripcion: "Sesiones para mejorar la comunicación, los acuerdos y la resolución de conflictos.", href: "" },
        { nombre: "Orientación a madres y padres", descripcion: "Herramientas de crianza respetuosa y acompañamiento en cada etapa del desarrollo.", href: "" },
        { nombre: "Evaluación psicológica", descripcion: "Entrevista clínica y, según el caso, instrumentos de evaluación para elaborar informes.", href: "" },
        { nombre: "Sesiones en línea", descripcion: "Atención por videollamada para quienes viven lejos o prefieren la modalidad remota.", href: "" },
      ]
    : [
        { nombre: "Evaluación y diagnóstico", descripcion: "Revisión clínica de dientes y encías para definir un plan de cuidado a tu medida.", href: "" },
        { nombre: "Limpieza dental y prevención", descripcion: "Limpieza profesional, control de placa y pautas de higiene adaptadas a tu caso.", href: "" },
        { nombre: "Restauraciones", descripcion: "Reparación de caries y piezas desgastadas para recuperar función y aspecto natural.", href: "" },
        { nombre: "Ortodoncia", descripcion: "Estudio de la mordida y corrección progresiva de la posición de los dientes.", href: "" },
        { nombre: "Rehabilitación oral y prótesis", descripcion: "Reposición de piezas ausentes con coronas, puentes o prótesis.", href: "" },
        { nombre: "Odontopediatría", descripcion: "Atención preventiva y adaptación gradual para niñas, niños y adolescentes.", href: "" },
      ],

  pasosPrimeraCita: esPsicologo
    ? [
        { numero: "1", titulo: "Coordinamos el horario", descripcion: "Elegimos día y modalidad (presencial o virtual) por WhatsApp o teléfono." },
        { numero: "2", titulo: "Entrevista inicial", descripcion: "Conversamos sobre tu motivo de consulta, a tu ritmo y sin juicios." },
        { numero: "3", titulo: "Definimos objetivos", descripcion: "Acordamos qué temas trabajar y con qué frecuencia." },
        { numero: "4", titulo: "Resolvemos tus dudas", descripcion: "Te explicamos la duración de las sesiones y cómo reprogramar." },
      ]
    : [
        { numero: "1", titulo: "Reservas tu hora", descripcion: "Coordinamos día y hora por WhatsApp o teléfono." },
        { numero: "2", titulo: "Conversamos antes de revisar", descripcion: "Te escuchamos: el motivo de tu visita, tus antecedentes y tus dudas." },
        { numero: "3", titulo: "Revisión clínica", descripcion: "Examinamos con cuidado y te explicamos en lenguaje claro lo que encontramos." },
        { numero: "4", titulo: "Plan por etapas", descripcion: "Te presentamos las alternativas para que decidas cómo y cuándo avanzar." },
      ],

  equipo: [
    {
      nombre: "[Nombre del doctor]",
      especialidad: esPsicologo ? "Psicólogo clínico" : "Cirujano dentista",
      colegiaturaLabel: esPsicologo ? "C.Ps.P." : "COP",
      colegiaturaNumero: "[N.º de colegiatura]",
      foto: foto("Foto: retrato profesional del doctor en el consultorio"),
      frase: "[Frase breve del profesional sobre cómo atiende]",
      formacion: [
        "Título profesional: [Universidad]",
        "Especialización o posgrado: [Área] — [Institución]",
        "Colegiatura vigente y habilitada: [N.º de colegiatura]",
      ],
    },
  ],

  casosAntesDespues: [
    { id: "caso-1", titulo: "[Título del caso 1]", descripcion: "[Qué se hizo, en una línea]", antes: foto("Foto: antes (caso 1)"), despues: foto("Foto: después (caso 1)") },
    { id: "caso-2", titulo: "[Título del caso 2]", descripcion: "[Qué se hizo, en una línea]", antes: foto("Foto: antes (caso 2)"), despues: foto("Foto: después (caso 2)") },
    { id: "caso-3", titulo: "[Título del caso 3]", descripcion: "[Qué se hizo, en una línea]", antes: foto("Foto: antes (caso 3)"), despues: foto("Foto: después (caso 3)") },
  ],
  leyendaAntesDespues:
    "Imágenes publicadas con consentimiento del paciente. Los resultados pueden variar.",

  testimonios: [
    { autor: "[Iniciales, ej. M. R.]", tratamiento: "[Tratamiento]", comentario: "[Comentario real y verificable, publicado con permiso del paciente]" },
    { autor: "[Iniciales, ej. J. C.]", tratamiento: "[Tratamiento]", comentario: "[Comentario real y verificable, publicado con permiso del paciente]" },
    { autor: "[Iniciales, ej. L. V.]", tratamiento: "[Tratamiento]", comentario: "[Comentario real y verificable, publicado con permiso del paciente]" },
  ],
  googleReviewsUrl: "", // si queda vacío, el enlace "Ver reseñas en Google" no se muestra

  ubicacion: {
    distrito,
    direccion: "[Av. o calle, número, piso o consultorio]",
    ciudad: "[Ciudad]",
    referencia: "[Referencia: a cuántas cuadras de qué lugar conocido]",
    comoLlegar: [
      "[Transporte público: paradero y líneas cercanas]",
      "[En auto o taxi: por dónde ingresar y dónde estacionar]",
    ],
    horarios: [
      { dias: "Lunes a viernes", horas: "[Horario]" },
      { dias: "Sábados", horas: "[Horario]" },
      { dias: "Domingos y feriados", horas: "[Cerrado o con cita previa]" },
    ],
    // Opcional, mejora el SEO local. Ejemplo:
    // { dias: ["Monday","Tuesday","Wednesday","Thursday","Friday"], abre: "09:00", cierra: "19:00" }
    horariosSchema: [] as { dias: string[]; abre: string; cierra: string }[],
    mapaEmbedUrl: "", // pega aquí la URL del iframe de Google Maps
    mapaPlaceholderTexto: `Mapa: ubicación del consultorio en ${distrito}`,
  },

  contacto: {
    telefonoVisible: "[+51 999 999 999]",
    telefonoHref: "tel:[+51999999999]",
    whatsappNumero: "[51999999999]",
    whatsappMensaje: `Hola, quisiera consultar disponibilidad para una cita en ${nombre}.`,
    correo: "[contacto@tudominio.pe]",
    motivosSelect: [
      "Agendar primera consulta",
      "Consulta sobre un servicio",
      "Reprogramar una cita",
      "Consulta administrativa",
      "Otro motivo",
    ],
  },

  faq: [
    {
      pregunta: "¿Necesito cita para ser atendido?",
      respuesta: "Para dedicar a cada persona el tiempo que necesita, coordinamos las consultas por WhatsApp o teléfono. [Indicar si también hay atención sin cita]",
    },
    {
      pregunta: "¿Puedo reprogramar o cancelar mi cita?",
      respuesta: "Sí. Avísanos por WhatsApp o llamada con al menos [24] horas de anticipación para poder ofrecer ese horario a otra persona.",
    },
    {
      pregunta: "¿Qué medios de pago aceptan?",
      respuesta: "[Detallar medios de pago (efectivo, tarjetas, Yape, Plin, transferencia) y el tipo de comprobante que se emite]",
    },
    {
      pregunta: "¿Qué debo llevar a mi primera consulta?",
      respuesta: "Tu documento de identidad y, si los tienes, informes o exámenes recientes relacionados con tu consulta.",
    },
    esPsicologo
      ? {
          pregunta: "¿Lo que converso en las sesiones es confidencial?",
          respuesta: "Sí. La información de las sesiones es confidencial, con las excepciones que establecen la ley y el código de ética profesional.",
        }
      : {
          pregunta: "¿Cómo sabré qué tratamiento necesito y cuánto costará?",
          respuesta: "Depende de cada caso. Después de la evaluación te explicamos las opciones y su costo antes de empezar cualquier procedimiento.",
        },
    {
      pregunta: "¿El consultorio tiene acceso para personas con movilidad reducida?",
      respuesta: "[Indicar si hay acceso, rampa o ascensor]",
    },
  ],

  footer: {
    privacidadHref: "/privacidad", // crea esta página (no cuenta en el límite del plan)
    libroReclamacionesHref: "[URL del Libro de Reclamaciones de Indecopi del cliente]",
    // Las redes con href vacío no se muestran.
    redesSociales: [
      { nombre: "Instagram", href: "" },
      { nombre: "Facebook", href: "" },
    ],
    derechos: `© ${new Date().getFullYear()} ${nombre}. Todos los derechos reservados.`,
  },
};

// ----------------------------------------------------------------------------
// FRENO DE PUBLICACIÓN: evita subir a producción marcadores o fotos pendientes.
// ----------------------------------------------------------------------------
const hayMarcadores = (v: unknown): boolean =>
  typeof v === "string"
    ? /\[[^\]]+\]/.test(v)
    : Array.isArray(v)
      ? v.some(hayMarcadores)
      : v && typeof v === "object"
        ? Object.entries(v).some(([k, x]) => k !== "placeholder" && hayMarcadores(x))
        : false;

const visible = {
  ...site,
  casosAntesDespues: site.mostrarAntesDespues ? site.casosAntesDespues : [],
  testimonios: site.mostrarTestimonios ? site.testimonios : [],
};
const imagenes: Imagen[] = [
  site.hero.imagen,
  ...site.equipo.map((m) => m.foto),
  ...visible.casosAntesDespues.flatMap((c) => [c.antes, c.despues]),
];
const pendientes: string[] = [];
if (hayMarcadores(visible)) pendientes.push("quedan [marcadores] sin reemplazar");
if (imagenes.some((i) => !i.src)) pendientes.push("faltan fotos reales");
if (!site.ubicacion.mapaEmbedUrl) pendientes.push("falta la URL del mapa");

const esDemo = Boolean(import.meta.env.PUBLIC_DEMO);
if (import.meta.env.PROD && !esDemo && pendientes.length > 0) {
  throw new Error(`No se puede publicar: ${pendientes.join("; ")}.`);
}

// ----------------------------------------------------------------------------
// DERIVADOS
// ----------------------------------------------------------------------------
// Ícono de WhatsApp (path completo, con el teléfono dentro del globo)
const waPath =
  "M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z";

const whatsappLink = `https://wa.me/${site.contacto.whatsappNumero}?text=${encodeURIComponent(site.contacto.whatsappMensaje)}`;

const navLinks = [
  { texto: "Inicio", href: "#inicio", mostrar: true },
  { texto: site.textosSecciones.serviciosNav, href: "#servicios", mostrar: true },
  { texto: site.textosSecciones.primeraCitaNav, href: "#primera-cita", mostrar: true },
  { texto: "Equipo", href: "#equipo", mostrar: true },
  { texto: "Casos", href: "#resultados", mostrar: site.mostrarAntesDespues },
  { texto: "Opiniones", href: "#testimonios", mostrar: site.mostrarTestimonios },
  { texto: "Ubicación", href: "#ubicacion", mostrar: true },
  { texto: "Preguntas", href: "#faq", mostrar: true },
  { texto: "Contacto", href: "#contacto", mostrar: true },
].filter((item) => item.mostrar);

const redes = site.footer.redesSociales.filter((r) => r.href);
const principal = site.equipo[0];

const schemaData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": site.tipo === "dentista" ? "Dentist" : "MedicalBusiness",
  name: site.nombre,
  description: site.seo.descripcion,
  telephone: site.contacto.telefonoVisible,
  email: site.contacto.correo,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.ubicacion.direccion,
    addressLocality: site.ubicacion.distrito,
    addressRegion: site.ubicacion.ciudad,
    addressCountry: "PE",
  },
  ...(Astro.site ? { url: Astro.site.href } : {}),
  ...(redes.length ? { sameAs: redes.map((r) => r.href) } : {}),
  ...(site.ubicacion.horariosSchema.length
    ? {
        openingHoursSpecification: site.ubicacion.horariosSchema.map((h) => ({
          "@type": "OpeningHoursSpecification",
          dayOfWeek: h.dias,
          opens: h.abre,
          closes: h.cierra,
        })),
      }
    : {}),
};
---

<Layout
  title={site.seo.titulo}
  description={site.seo.descripcion}
  siteName={site.nombre}
  colores={site.colores}
  schemaData={schemaData}
  noindex={esDemo}
>
  <!-- HEADER -->
  <header class="sticky top-0 z-40 border-b border-ink/10 bg-surface/95 backdrop-blur-md">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="#inicio" class="font-heading text-lg font-semibold tracking-tight text-primary-dark sm:text-xl">
        {site.nombre}
      </a>

      <nav aria-label="Navegación principal" class="hidden lg:flex lg:items-center lg:gap-6">
        {navLinks.map((item) => (
          <a href={item.href} class="text-sm font-medium text-ink/80 transition-colors hover:text-primary">
            {item.texto}
          </a>
        ))}
      </nav>

      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-surface transition-colors hover:bg-primary-dark lg:inline-flex"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={waPath} /></svg>
        Agendar por WhatsApp
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="inline-flex items-center justify-center rounded-lg border border-ink/20 p-2.5 text-ink lg:hidden"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav id="mobile-menu" aria-label="Navegación móvil" class="hidden border-t border-ink/10 bg-surface px-4 pt-3 pb-6 lg:hidden">
      <ul class="flex flex-col gap-1">
        {navLinks.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link block rounded-lg px-3 py-2 text-base font-medium text-ink hover:bg-primary/10">
              {item.texto}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-base font-semibold text-surface"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={waPath} /></svg>
        Agendar por WhatsApp
      </a>
    </nav>
  </header>

  <main id="contenido-principal">
    <!-- HERO -->
    <section id="inicio" class="scroll-mt-20 py-12 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/5 px-3.5 py-1.5 text-sm font-medium text-primary-dark">
              <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
              Atención en {site.ubicacion.distrito}
            </p>
            <h1 class="mt-5 text-3xl leading-tight font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">
              {site.hero.titular}
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/85">
              {site.hero.subtitulo}
            </p>

            <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 rounded-full bg-primary px-7 py-4 text-base font-semibold text-surface transition-colors hover:bg-primary-dark"
              >
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={waPath} /></svg>
                Agendar por WhatsApp
              </a>
              <a
                href={site.contacto.telefonoHref}
                class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-primary-dark/25 px-7 py-3.5 text-base font-semibold text-primary-dark transition-colors hover:border-primary-dark"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                Llamar al {site.contacto.telefonoVisible}
              </a>
            </div>

            <dl class="mt-10 grid grid-cols-1 gap-4 border-t border-ink/15 pt-8 sm:grid-cols-3">
              {site.hero.datosConfianza.map((dato) => (
                <div class="border-l-2 border-accent pl-3.5">
                  <dt class="text-sm text-ink/75">{dato.etiqueta}</dt>
                  <dd class="mt-0.5 text-sm font-semibold text-ink">{dato.valor}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="lg:col-span-5">
            <div class="relative aspect-[4/5] w-full overflow-hidden rounded-2xl bg-primary/10">
              {site.hero.imagen.src ? (
                <img
                  src={site.hero.imagen.src}
                  alt={site.hero.imagen.alt}
                  width="800"
                  height="1000"
                  fetchpriority="high"
                  class="h-full w-full object-cover"
                />
              ) : (
