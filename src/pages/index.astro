            <p class="mt-2 text-sm text-ink/80">
              {principal.nombre} — {principal.colegiaturaLabel} {principal.colegiaturaNumero}
            </p>
          )}
          <p class="mt-1 text-sm text-ink/75">
            {site.ubicacion.direccion}, {site.ubicacion.distrito}
          </p>
        </div>

        <div class="md:col-span-4">
          <h2 class="text-sm font-semibold text-ink/75">Información legal</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a href={site.footer.privacidadHref} class="text-ink/85 underline-offset-4 hover:text-primary hover:underline">
                Política de privacidad
              </a>
            </li>
            <li>
              <a
                href={site.footer.libroReclamacionesHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg border border-ink/25 px-3 py-1.5 font-semibold text-ink hover:border-primary"
              >
                <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
