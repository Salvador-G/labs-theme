---
import Layout from "../layouts/Layout.astro";
import siteData from "../data/site.json";
import { verifyPublishReadiness, type SiteConfig } from "../lib/publish-guard";
import { buildSchemaData } from "../lib/schema";
import type { PresetName, HeroVariant, ServiciosVariant } from "../lib/presets";

import HeroDividido from "../components/hero/HeroDividido.astro";
import HeroCentrado from "../components/hero/HeroCentrado.astro";
import ServiciosLista from "../components/servicios/ServiciosLista.astro";
import ServiciosRejilla from "../components/servicios/ServiciosRejilla.astro";

const site: SiteConfig = siteData;
const esDemo = import.meta.env.PUBLIC_DEMO === "true";

verifyPublishReadiness(site, esDemo, import.meta.env.PROD);

const preset = (site.diseno.preset || "sereno") as PresetName;
const heroVariant = (site.diseno.variantes?.hero || "dividido") as HeroVariant;
const serviciosVariant = (site.diseno.variantes?.servicios ||
  "lista") as ServiciosVariant;

const HeroComponent = heroVariant === "centrado" ? HeroCentrado : HeroDividido;
const ServiciosComponent =
  serviciosVariant === "rejilla" ? ServiciosRejilla : ServiciosLista;

const waPath =
  "M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z";

const whatsappLink = `https://wa.me/${site.contacto.whatsappNumero}?text=${encodeURIComponent(site.contacto.whatsappMensaje)}`;

// Mapa de navegación sincronizado con `site.diseno.orden`
const navCatalog: Record<
  string,
  { texto: string; href: string; mostrar: boolean }
> = {
  hero: { texto: "Inicio", href: "#inicio", mostrar: true },
  servicios: {
    texto: site.textosSecciones.serviciosNav,
    href: "#servicios",
    mostrar: true,
  },
  "primera-cita": {
    texto: site.textosSecciones.primeraCitaNav,
    href: "#primera-cita",
    mostrar: true,
  },
  equipo: { texto: "Equipo", href: "#equipo", mostrar: true },
  resultados: {
    texto: "Casos",
    href: "#resultados",
    mostrar: site.mostrarAntesDespues,
  },
  testimonios: {
    texto: "Opiniones",
    href: "#testimonios",
    mostrar: site.mostrarTestimonios,
  },
  ubicacion: { texto: "Ubicación", href: "#ubicacion", mostrar: true },
  faq: { texto: "Preguntas", href: "#faq", mostrar: true },
  contacto: { texto: "Contacto", href: "#contacto", mostrar: true },
};

const navLinks = site.diseno.orden
  .map((key) => navCatalog[key])
  .filter((item) => item && item.mostrar);

const redes = site.footer.redesSociales.filter((r) => r.href);
const principal = site.equipo[0];
const schemaData = buildSchemaData(site, Astro.site);
---

<Layout
  title={site.seo.titulo}
  description={site.seo.descripcion}
  siteName={site.nombre}
  preset={preset}
  colores={site.diseno.colores}
  schemaData={schemaData}
  noindex={esDemo}
  esDemo={esDemo}
>
  <!-- HEADER -->
  <header
    class="sticky top-0 z-40 border-b border-ink/10 bg-surface/95 backdrop-blur-md"
  >
    <div
      class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
    >
      <a
        href="#inicio"
        class="font-heading text-lg font-semibold tracking-tight text-primary-dark sm:text-xl"
      >
        {site.nombre}
      </a>

      <nav
        aria-label="Navegación principal"
        class="hidden lg:flex lg:items-center lg:gap-6"
      >
        {
          navLinks.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-ink/80 transition-colors hover:text-primary"
            >
              {item.texto}
            </a>
          ))
        }
      </nav>

      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-(--radius-btn) bg-primary px-5 py-2.5 text-sm font-semibold text-surface transition-colors hover:bg-primary-dark lg:inline-flex"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"
          ><path d={waPath}></path></svg
        >
        Agendar por WhatsApp
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="inline-flex items-center justify-center rounded-(--radius-btn) border border-ink/20 p-2.5 text-ink lg:hidden"
      >
        <svg
          id="icon-open"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="hidden h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav
      id="mobile-menu"
      aria-label="Navegación móvil"
      class="hidden border-t border-ink/10 bg-surface px-4 pt-3 pb-6 lg:hidden"
    >
      <ul class="flex flex-col gap-1">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-nav-link block rounded-(--radius-btn) px-3 py-2 text-base font-medium text-ink hover:bg-primary/10"
              >
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex w-full items-center justify-center gap-2 rounded-(--radius-btn) bg-primary px-5 py-3 text-base font-semibold text-surface"
      >
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"
          ><path d={waPath}></path></svg
        >
        Agendar por WhatsApp
      </a>
    </nav>
  </header>

  <main id="contenido-principal">
    {
      site.diseno.orden.map((seccion) => {
        switch (seccion) {
          case "hero":
            return (
              <HeroComponent
                site={site}
                whatsappLink={whatsappLink}
                waPath={waPath}
              />
            );

          case "servicios":
            return <ServiciosComponent site={site} />;

          case "primera-cita":
            return (
              <section
                id="primera-cita"
                class="scroll-mt-20 bg-primary-dark py-(--space-section) text-surface"
              >
                <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
                  <div class="lg:col-span-5">
                    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
                      {site.textosSecciones.primeraCitaTitulo}
                    </h2>
                    <p class="mt-4 max-w-sm text-base leading-relaxed text-surface/85">
                      {site.textosSecciones.primeraCitaSubtitulo}
                    </p>
                    <a
                      href={whatsappLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-8 inline-flex rounded-(--radius-btn) bg-surface px-6 py-3.5 text-sm font-semibold text-primary-dark transition-opacity hover:opacity-90"
                    >
                      Consultar horarios disponibles
                    </a>
                  </div>

                  <ol class="divide-y divide-surface/20 border-y border-surface/20 lg:col-span-7">
                    {site.pasosPrimeraCita.map((paso) => (
                      <li class="grid grid-cols-[3rem_1fr] gap-4 py-6">
                        <span
                          class="font-heading text-3xl leading-none text-surface/80"
                          aria-hidden="true"
                        >
                          {paso.numero}
                        </span>
                        <div>
                          <h3 class="text-lg font-semibold">{paso.titulo}</h3>
                          <p class="mt-1.5 text-sm leading-relaxed text-surface/85">
                            {paso.descripcion}
                          </p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>
              </section>
            );

          case "equipo":
            return (
              <section id="equipo" class="scroll-mt-20 py-(--space-section)">
                <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                  <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                    Quién te atenderá
                  </h2>

                  <div class="mt-12 space-y-16">
                    {site.equipo.map((miembro) => (
                      <article class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
                        <div class="lg:col-span-4">
                          <div class="aspect-[3/4] w-full overflow-hidden rounded-(--radius-card) bg-primary/10">
                            {miembro.foto.src ? (
                              <img
                                src={miembro.foto.src}
                                alt={miembro.foto.alt}
                                width="600"
                                height="800"
                                loading="lazy"
                                class="h-full w-full object-cover"
                              />
                            ) : (
                              <div class="flex h-full items-end p-5">
                                <p class="w-full rounded-(--radius-card) bg-surface/95 p-3 text-sm font-medium text-ink">
                                  {miembro.foto.placeholder}
                                </p>
                              </div>
                            )}
                          </div>
                        </div>

                        <div class="lg:col-span-8">
                          <h3 class="text-2xl font-semibold text-ink sm:text-3xl">
                            {miembro.nombre}
                          </h3>
                          <p class="mt-1 text-base text-ink/80">
                            {miembro.especialidad} — {miembro.colegiaturaLabel}{" "}
                            {miembro.colegiaturaNumero}
                          </p>

                          <blockquote class="mt-6 max-w-xl border-l-2 border-accent pl-4 font-heading text-xl leading-snug text-ink">
                            “{miembro.frase}”
                          </blockquote>

                          <h4 class="mt-8 text-sm font-semibold text-ink">
                            Formación y registro profesional
                          </h4>
                          <ul class="mt-3 space-y-2">
                            {miembro.formacion.map((item) => (
                              <li class="flex items-start gap-2.5 text-sm text-ink/85">
                                <svg
                                  class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  aria-hidden="true"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.5 12.75l6 6 9-13.5"
                                  />
                                </svg>
                                <span>{item}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              </section>
            );

          case "resultados":
            return (
              site.mostrarAntesDespues && (
                <section
                  id="resultados"
                  class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
                >
                  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
                      <h2 class="max-w-xl text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                        Casos atendidos en el consultorio
                      </h2>
                      <p class="max-w-sm text-sm leading-relaxed text-ink/80">
                        {site.leyendaAntesDespues}
                      </p>
                    </div>

                    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-3">
                      {site.casosAntesDespues.map((caso) => (
                        <article>
                          <div
                            class="before-after-wrapper relative aspect-[4/3] w-full overflow-hidden rounded-(--radius-card) bg-ink/10 select-none"
                            style="--pos: 50%;"
                          >
                            <div class="absolute inset-0">
                              {caso.despues.src ? (
                                <img
                                  src={caso.despues.src}
                                  alt={caso.despues.alt}
                                  loading="lazy"
                                  class="h-full w-full object-cover"
                                />
                              ) : (
                                <div class="flex h-full items-end bg-primary/15 p-3">
                                  <p class="rounded bg-surface/95 p-2.5 text-xs font-medium text-ink">
                                    {caso.despues.placeholder}
                                  </p>
                                </div>
                              )}
                              <span class="absolute top-3 right-3 rounded bg-primary-dark px-2.5 py-1 text-xs font-semibold text-surface">
                                Después
                              </span>
                            </div>

                            <div
                              class="absolute inset-0"
                              style="clip-path: inset(0 calc(100% - var(--pos)) 0 0);"
                            >
                              {caso.antes.src ? (
                                <img
                                  src={caso.antes.src}
                                  alt={caso.antes.alt}
                                  loading="lazy"
                                  class="h-full w-full object-cover"
                                />
                              ) : (
                                <div class="flex h-full items-end bg-ink/15 p-3">
                                  <p class="rounded bg-surface/95 p-2.5 text-xs font-medium text-ink">
                                    {caso.antes.placeholder}
                                  </p>
                                </div>
                              )}
                              <span class="absolute top-3 left-3 rounded bg-ink px-2.5 py-1 text-xs font-semibold text-surface">
                                Antes
                              </span>
                            </div>

                            <div
                              class="pointer-events-none absolute inset-y-0 w-0.5 bg-surface shadow"
                              style="left: var(--pos);"
                              aria-hidden="true"
                            />
                          </div>

                          <input
                            id={`slider-${caso.id}`}
                            type="range"
                            min="0"
                            max="100"
                            value="50"
                            aria-label={`Comparar antes y después: ${caso.titulo}`}
                            class="before-after-slider mt-4 h-2 w-full cursor-pointer appearance-none rounded-lg bg-ink/20 accent-primary"
                          />
                          <h3 class="mt-4 text-lg font-semibold text-ink">
                            {caso.titulo}
                          </h3>
                          <p class="mt-1 text-sm text-ink/80">
                            {caso.descripcion}
                          </p>
                        </article>
                      ))}
                    </div>
                  </div>
                </section>
              )
            );

          case "testimonios":
            return (
              site.mostrarTestimonios && (
                <section
                  id="testimonios"
                  class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
                >
                  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
                      <h2 class="max-w-xl text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                        Lo que dicen quienes ya se atendieron
                      </h2>
                      {site.googleReviewsUrl && (
                        <a
                          href={site.googleReviewsUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-sm font-semibold text-primary underline underline-offset-4 hover:text-primary-dark"
                        >
                          Ver reseñas en Google
                          <span class="sr-only">
                            {" "}
                            (se abre en una pestaña nueva)
                          </span>
                        </a>
                      )}
                    </div>

                    <ul class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
                      {site.testimonios.map((item) => (
                        <li>
                          <figure class="border-t-2 border-accent pt-5">
                            <blockquote class="font-heading text-lg leading-snug text-ink">
                              “{item.comentario}”
                            </blockquote>
                            <figcaption class="mt-5 text-sm">
                              <span class="font-semibold text-ink">
                                {item.autor}
                              </span>
                              <span class="block text-ink/75">
                                {item.tratamiento}
                              </span>
                            </figcaption>
                          </figure>
                        </li>
                      ))}
                    </ul>
                  </div>
                </section>
              )
            );

          case "ubicacion":
            return (
              <section
                id="ubicacion"
                class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
              >
                <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
                  <div class="lg:col-span-6">
                    <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                      Dónde estamos y cuándo atendemos
                    </h2>

                    <div class="mt-8 space-y-8">
                      <div>
                        <h3 class="text-sm font-semibold text-ink/75">
                          Dirección
                        </h3>
                        <p class="mt-1 text-base font-semibold text-ink">
                          {site.ubicacion.direccion}, {site.ubicacion.distrito},{" "}
                          {site.ubicacion.ciudad}
                        </p>
                        <p class="mt-1 text-sm text-ink/80">
                          {site.ubicacion.referencia}
                        </p>
                      </div>

                      <div>
                        <h3 class="text-sm font-semibold text-ink/75">
                          Horario
                        </h3>
                        <table class="mt-3 w-full border-collapse text-left text-sm">
                          <caption class="sr-only">
                            Horarios de atención semanal
                          </caption>
                          <tbody class="divide-y divide-ink/10 border-y border-ink/10">
                            {site.ubicacion.horarios.map((h) => (
                              <tr>
                                <th
                                  scope="row"
                                  class="py-3 pr-4 font-semibold text-ink"
                                >
                                  {h.dias}
                                </th>
                                <td class="py-3 text-ink/85">{h.horas}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>

                      <div>
                        <h3 class="text-sm font-semibold text-ink/75">
                          Cómo llegar
                        </h3>
                        <ul class="mt-2 space-y-2">
                          {site.ubicacion.comoLlegar.map((indicacion) => (
                            <li class="flex items-start gap-2.5 text-sm text-ink/85">
                              <span
                                class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
                                aria-hidden="true"
                              />
                              <span>{indicacion}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>

                  <div class="lg:col-span-6">
                    <div class="aspect-[4/3] w-full overflow-hidden rounded-(--radius-card) bg-primary/10">
                      {site.ubicacion.mapaEmbedUrl ? (
                        <iframe
                          src={site.ubicacion.mapaEmbedUrl}
                          title={`Mapa de ubicación de ${site.nombre}`}
                          class="h-full w-full border-0"
                          loading="lazy"
                          referrerpolicy="no-referrer-when-downgrade"
                        />
                      ) : (
                        <div class="flex h-full w-full flex-col items-center justify-center p-8 text-center">
                          <svg
                            class="h-10 w-10 text-primary"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                            />
                          </svg>
                          <p class="mt-3 max-w-sm text-sm font-medium text-ink">
                            {site.ubicacion.mapaPlaceholderTexto}
                          </p>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </section>
            );

          case "faq":
            return (
              <section
                id="faq"
                class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
              >
                <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
                  <h2 class="max-w-2xl text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                    Antes de agendar, esto es lo que suelen preguntar
                  </h2>

                  <div class="mt-10 divide-y divide-ink/15 border-y border-ink/15">
                    {site.faq.map((item) => (
                      <details class="group py-5">
                        <summary class="flex list-none items-center justify-between gap-4 text-left text-base font-semibold text-ink hover:text-primary">
                          <span>{item.pregunta}</span>
                          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-(--radius-btn) border border-ink/25 text-primary transition-transform group-open:rotate-45 motion-reduce:transition-none">
                            <svg
                              class="h-4 w-4"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="2"
                              aria-hidden="true"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 4.5v15m7.5-7.5h-15"
                              />
                            </svg>
                          </span>
                        </summary>
                        <p class="mt-3 max-w-2xl pr-10 text-sm leading-relaxed text-ink/80">
                          {item.respuesta}
                        </p>
                      </details>
                    ))}
                  </div>
                </div>
              </section>
            );

          case "contacto":
            return (
              <section
                id="contacto"
                class="scroll-mt-20 border-t border-ink/10 py-(--space-section)"
              >
                <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                  <div
                    class:list={[
                      "grid grid-cols-1 gap-12",
                      site.mostrarFormulario && "lg:grid-cols-12",
                    ]}
                  >
                    <div
                      class:list={[
                        site.mostrarFormulario ? "lg:col-span-5" : "max-w-xl",
                      ]}
                    >
                      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
                        Coordina tu cita
                      </h2>
                      <p class="mt-3 text-base leading-relaxed text-ink/80">
                        La forma más rápida de conseguir un horario es
                        escribirnos por WhatsApp o llamarnos en horario de
                        atención.
                      </p>

                      <a
                        href={whatsappLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-8 inline-flex items-center justify-center gap-3 rounded-(--radius-btn) bg-primary px-7 py-4 text-base font-semibold text-surface transition-colors hover:bg-primary-dark"
                      >
                        <svg
                          class="h-5 w-5 fill-current"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path d={waPath} />
                        </svg>
                        Escribir por WhatsApp
                      </a>

                      <dl class="mt-8 space-y-4 border-t border-ink/15 pt-6 text-sm">
                        <div>
                          <dt class="font-semibold text-ink">Teléfono</dt>
                          <dd class="mt-0.5">
                            <a
                              href={site.contacto.telefonoHref}
                              class="text-primary underline underline-offset-4"
                            >
                              {site.contacto.telefonoVisible}
                            </a>
                          </dd>
                        </div>
                        <div>
                          <dt class="font-semibold text-ink">Correo</dt>
                          <dd class="mt-0.5">
                            <a
                              href={`mailto:${site.contacto.correo}`}
                              class="text-primary underline underline-offset-4"
                            >
                              {site.contacto.correo}
                            </a>
                          </dd>
                        </div>
                      </dl>
                    </div>

                    {site.mostrarFormulario && (
                      <div class="lg:col-span-7">
                        <form
                          action="#"
                          method="POST"
                          class="rounded-(--radius-card) border border-ink/15 p-6 sm:p-10"
                        >
                          <h3 class="text-xl font-semibold text-ink">
                            Te contactamos nosotros
                          </h3>
                          <p class="mt-1 text-sm text-ink/80">
                            Por tu privacidad, este formulario no pide síntomas
                            ni historia clínica.
                          </p>

                          <div class="mt-6 space-y-5">
                            <div>
                              <label
                                for="nombre"
                                class="block text-sm font-semibold text-ink"
                              >
                                Nombre completo
                              </label>
                              <input
                                type="text"
                                id="nombre"
                                name="nombre"
                                required
                                autocomplete="name"
                                placeholder="Ej. María Fernández"
                                class="mt-2 block w-full rounded-(--radius-btn) border border-ink/30 bg-surface px-4 py-3 text-sm text-ink placeholder:text-ink/65 focus:border-primary"
                              />
                            </div>

                            <div>
                              <label
                                for="telefono"
                                class="block text-sm font-semibold text-ink"
                              >
                                Celular (WhatsApp)
                              </label>
                              <input
                                type="tel"
                                id="telefono"
                                name="telefono"
                                required
                                autocomplete="tel"
                                placeholder="Ej. 999 888 777"
                                class="mt-2 block w-full rounded-(--radius-btn) border border-ink/30 bg-surface px-4 py-3 text-sm text-ink placeholder:text-ink/65 focus:border-primary"
                              />
                            </div>

                            <div>
                              <label
                                for="motivo"
                                class="block text-sm font-semibold text-ink"
                              >
                                Motivo general
                              </label>
                              <select
                                id="motivo"
                                name="motivo"
                                required
                                class="mt-2 block w-full rounded-(--radius-btn) border border-ink/30 bg-surface px-4 py-3 text-sm text-ink focus:border-primary"
                              >
                                <option value="" disabled selected>
                                  Elige una opción
                                </option>
                                {site.contacto.motivosSelect.map((motivo) => (
                                  <option value={motivo}>{motivo}</option>
                                ))}
                              </select>
                            </div>

                            <div class="flex items-start gap-3 pt-2">
                              <input
                                id="consentimiento"
                                name="consentimiento"
                                type="checkbox"
                                required
                                class="mt-1 h-4 w-4 rounded border-ink/30 accent-primary"
                              />
                              <label
                                for="consentimiento"
                                class="text-sm leading-relaxed text-ink/85"
                              >
                                Acepto que usen mis datos de contacto para
                                responder esta solicitud, según la
                                <a
                                  href={site.footer.privacidadHref}
                                  class="font-semibold text-primary underline underline-offset-2"
                                >
                                  política de privacidad
                                </a>
                                .
                              </label>
                            </div>

                            <button
                              type="submit"
                              class="w-full rounded-(--radius-btn) bg-primary-dark px-6 py-3.5 text-sm font-semibold text-surface transition-colors hover:bg-primary"
                            >
                              Enviar solicitud
                            </button>
                          </div>
                        </form>
                      </div>
                    )}
                  </div>
                </div>
              </section>
            );

          default:
            return null;
        }
      })
    }
  </main>

  <!-- PIE DE PÁGINA -->
  <footer class="border-t border-ink/15 py-12 pb-24 lg:pb-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="font-heading text-lg font-semibold text-primary-dark">
            {site.nombre}
          </p>
          {
            principal && (
              <p class="mt-2 text-sm text-ink/80">
                {principal.nombre} — {principal.colegiaturaLabel}{" "}
                {principal.colegiaturaNumero}
              </p>
            )
          }
          <p class="mt-1 text-sm text-ink/75">
            {site.ubicacion.direccion}, {site.ubicacion.distrito}
          </p>
        </div>

        <div class="md:col-span-4">
          <h2 class="text-sm font-semibold text-ink/75">Información legal</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href={site.footer.privacidadHref}
                class="text-ink/85 underline-offset-4 hover:text-primary hover:underline"
              >
                Política de privacidad
              </a>
            </li>
            <li>
              <a
                href={site.footer.libroReclamacionesHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-(--radius-btn) border border-ink/25 px-3 py-1.5 font-semibold text-ink hover:border-primary"
              >
                <svg
                  class="h-4 w-4 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                  ></path>
                </svg>
                Libro de Reclamaciones
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </li>
          </ul>
        </div>

        {
          redes.length > 0 && (
            <div class="md:col-span-3">
              <h2 class="text-sm font-semibold text-ink/75">Redes sociales</h2>
              <ul class="mt-3 flex flex-wrap gap-3">
                {redes.map((red) => (
                  <li>
                    <a
                      href={red.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block rounded-(--radius-btn) border border-ink/25 px-3.5 py-1.5 text-sm font-medium text-ink hover:border-primary hover:text-primary"
                    >
                      {red.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <p class="mt-10 border-t border-ink/10 pt-6 text-sm text-ink/75">
        {site.footer.derechos}
      </p>
    </div>
  </footer>

  <!-- Botón flotante de WhatsApp (solo celular) -->
  <a
    href={whatsappLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Agendar cita por WhatsApp"
    class="fixed right-4 bottom-4 z-40 inline-flex items-center gap-2 rounded-(--radius-btn) bg-primary px-4 py-3 text-sm font-semibold text-surface shadow-lg lg:hidden"
  >
    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"
      ><path d={waPath}></path></svg
    >
    WhatsApp
  </a>

  <script>
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    function setMenu(abierto: boolean) {
      if (!menuToggle || !mobileMenu || !iconOpen || !iconClose) return;
      menuToggle.setAttribute("aria-expanded", String(abierto));
      menuToggle.setAttribute(
        "aria-label",
        abierto ? "Cerrar menú de navegación" : "Abrir menú de navegación",
      );
      mobileMenu.classList.toggle("hidden", !abierto);
      iconOpen.classList.toggle("hidden", abierto);
      iconClose.classList.toggle("hidden", !abierto);
    }

    menuToggle?.addEventListener("click", () =>
      setMenu(menuToggle.getAttribute("aria-expanded") !== "true"),
    );
    document
      .querySelectorAll(".mobile-nav-link")
      .forEach((enlace) =>
        enlace.addEventListener("click", () => setMenu(false)),
      );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setMenu(false);
    });

    document
      .querySelectorAll<HTMLInputElement>(".before-after-slider")
      .forEach((slider) => {
        const wrapper = slider
          .closest("article")
          ?.querySelector<HTMLElement>(".before-after-wrapper");
        if (!wrapper) return;
        slider.addEventListener("input", () => {
          wrapper.style.setProperty("--pos", `${slider.value}%`);
        });
      });
  </script>
</Layout>
