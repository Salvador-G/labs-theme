                </p>

                <div class="mt-6 space-y-5">
                  <div>
                    <label for="nombre" class="block text-sm font-semibold text-ink">Nombre completo</label>
                    <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Ej. María Fernández" class="mt-2 block w-full rounded-xl border border-ink/30 bg-surface px-4 py-3 text-sm text-ink placeholder:text-ink/65 focus:border-primary" />
                  </div>

                  <div>
                    <label for="telefono" class="block text-sm font-semibold text-ink">Celular (WhatsApp)</label>
                    <input type="tel" id="telefono" name="telefono" required autocomplete="tel" placeholder="Ej. 999 888 777" class="mt-2 block w-full rounded-xl border border-ink/30 bg-surface px-4 py-3 text-sm text-ink placeholder:text-ink/65 focus:border-primary" />
                  </div>

                  <div>
                    <label for="motivo" class="block text-sm font-semibold text-ink">Motivo general</label>
                    <select id="motivo" name="motivo" required class="mt-2 block w-full rounded-xl border border-ink/30 bg-surface px-4 py-3 text-sm text-ink focus:border-primary">
                      <option value="" disabled selected>Elige una opción</option>
                      {site.contacto.motivosSelect.map((motivo) => (
                        <option value={motivo}>{motivo}</option>
                      ))}
                    </select>
                  </div>

                  <div class="flex items-start gap-3 pt-2">
                    <input id="consentimiento" name="consentimiento" type="checkbox" required class="mt-1 h-4 w-4 rounded border-ink/30 accent-primary" />
                    <label for="consentimiento" class="text-sm leading-relaxed text-ink/85">
                      Acepto que usen mis datos de contacto para responder esta solicitud, según la
                      <a href={site.footer.privacidadHref} class="font-semibold text-primary underline underline-offset-2">política de privacidad</a>.
                    </label>
                  </div>

                  <button type="submit" class="w-full rounded-full bg-primary-dark px-6 py-3.5 text-sm font-semibold text-surface transition-colors hover:bg-primary">
                    Enviar solicitud
                  </button>
                </div>
              </form>
            </div>
          )}
        </div>
      </div>
