            </p>

            <a
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center justify-center gap-3 rounded-full bg-primary px-7 py-4 text-base font-semibold text-surface transition-colors hover:bg-primary-dark"
            >
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={waPath} /></svg>
              Escribir por WhatsApp
            </a>

            <dl class="mt-8 space-y-4 border-t border-ink/15 pt-6 text-sm">
              <div>
                <dt class="font-semibold text-ink">Teléfono</dt>
                <dd class="mt-0.5">
                  <a href={site.contacto.telefonoHref} class="text-primary underline underline-offset-4">{site.contacto.telefonoVisible}</a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-ink">Correo</dt>
                <dd class="mt-0.5">
                  <a href={`mailto:${site.contacto.correo}`} class="text-primary underline underline-offset-4">{site.contacto.correo}</a>
                </dd>
              </div>
            </dl>
          </div>

          {site.mostrarFormulario && (
            <div class="lg:col-span-7">
              <!-- TODO: conectar el envío (correo o servicio de formularios) antes de publicar -->
              <form action="#" method="POST" class="rounded-2xl border border-ink/15 p-6 sm:p-10">
                <h3 class="text-xl font-semibold text-ink">Te contactamos nosotros</h3>
                <p class="mt-1 text-sm text-ink/80">
