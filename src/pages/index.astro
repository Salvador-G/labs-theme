                  ))}
                </tbody>
              </table>
            </div>

            <div>
              <h3 class="text-sm font-semibold text-ink/75">Cómo llegar</h3>
              <ul class="mt-2 space-y-2">
                {site.ubicacion.comoLlegar.map((indicacion) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink/85">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                    <span>{indicacion}</span>
                  </li>
                ))}
