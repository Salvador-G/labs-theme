                  </div>

                  <div class="pointer-events-none absolute inset-y-0 w-0.5 bg-surface shadow" style="left: var(--pos);" aria-hidden="true"></div>
                </div>

                <input
                  id={`slider-${caso.id}`}
                  type="range"
                  min="0"
                  max="100"
