          </div>

          <ul class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
            {site.testimonios.map((item) => (
              <li>
                <figure class="border-t-2 border-accent pt-5">
                  <blockquote class="font-heading text-lg leading-snug text-ink">“{item.comentario}”</blockquote>
                  <figcaption class="mt-5 text-sm">
                    <span class="font-semibold text-ink">{item.autor}</span>
                    <span class="block text-ink/75">{item.tratamiento}</span>
                  </figcaption>
                </figure>
